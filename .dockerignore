# Docker build context excludes for the single-service image (Dockerfile).
# Docker's COPY does NOT consult .gitignore -- this file is the only
# defense against a host-only .venv/ (macOS/ARM binaries) clobbering the
# image's freshly `uv sync`'d Linux one via `COPY . .`, plus general image
# bloat / secret-baking risk (.tdd-swarm/reports/T-015-review.md
# Important-2/3).

# Host-only, platform-specific -- would silently overwrite the container's
# own venv if copied in.
.venv/

# VCS / swarm process bookkeeping -- not needed at runtime.
.git/
.github/
.tdd-swarm/
tickets/
docs/
TICKETS.md
*.pdf

# Python / tooling caches.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/

# Runtime artifacts (saved index, price cache) -- built fresh at container
# startup (lifespan bootstrap), never baked into the image.
artifacts/
# ...except the Form 4 artifact, which ships with the repo (T-039)
!artifacts/form4/
!artifacts/form4/**

# Raw (pre-merge) adapter output, if present -- corpus/v1/corpus.jsonl.gz
# (the merged snapshot the app actually reads for /api/prices + index
# bootstrap) is intentionally KEPT; so is ui/.
corpus/raw/

# Test suite -- not needed by the running production image.
tests/

# Env / secrets -- never bake a real .env file into an image; real config
# comes from Railway's own env vars at runtime.
.env
.env.*

# OS cruft.
.DS_Store
