# onrecord — environment variables (copy to .env; never commit real values)
#
# The graded core path (search/BM25/eval on the frozen corpus snapshot) runs
# fully offline and needs none of these. They're only used by ingest adapters
# (T-006/T-007/T-008) and the RAG extension (embeddings, LLM judge).

# EDGAR full-text search / submissions API requires a descriptive User-Agent,
# not a key (SEC fair-access policy): "Your Name your-email@example.com"
EDGAR_USER_AGENT=

# Financial Modeling Prep — earnings-call transcripts (T-008)
FMP_API_KEY=

# Hosted embeddings provider (RAG extension, Fri)
# Embeddings (text-embedding-3-large) AND the faithfulness judge (gpt-5-mini)
# both read this one variable:
OPENAI_API_KEY=

# LLM judge (faithfulness/relevancy/refusal evals) — different model family
# from the generator, per design spec Sec 5
# Grounded answer generation (claude-opus-5):
ANTHROPIC_API_KEY=

# Optional, read-only portfolio lens (see tickets/T-065.md):
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
